# Copy to .env; use single quotes for passwords containing $ or #.
PIA_USERNAME=''
PIA_PASSWORD=''
# Generate with: openssl rand -hex 24
TWITCH_M3U_KEY=''
# Use 7778 for local testing alongside an existing server on 7777.
TWITCH_M3U_PORT=7777
# Oracle containerized Caddy uses the host bridge: 172.19.0.1
TWITCH_M3U_BIND_IP=127.0.0.1
# Optional personal Twitch OAuth token.
TWITCH_AUTH_TOKEN=''
